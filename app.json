{
  "expo": {
    "name": "nenrin",
    "slug": "nenrin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nenrin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.caioalfonso.nenrin",
      "infoPlist": {
        "NSContactsUsageDescription": "Nenrin reads your contacts so it can find birthdays you have already saved, instead of asking you to type them in again."
      }
    },
    "android": {
      "package": "dev.caioalfonso.nenrin",
      "adaptiveIcon": {
        "backgroundColor": "#99C4E4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#244f7c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#244f7c"
        }
      ],
      "expo-image",
      [
        "expo-calendar",
        {
          "calendarPermission": "Nenrin reads your calendars to find birthdays already saved there, and, if you ask it to, adds your birthdays to a calendar of their own.",
          "remindersPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e6b795b-cfab-4d97-ba27-655b00165c75"
      }
    },
    "owner": "caioalfonso"
  }
}
